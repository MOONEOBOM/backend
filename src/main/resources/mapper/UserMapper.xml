<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
	PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ureca.ureca.domain.user.mapper.UserMapper">

	<select id="findById" resultType="com.ureca.ureca.domain.user.dto.User">
		SELECT id, email, name
		FROM users
		WHERE id = #{id}
	</select>

	<insert id="insertUser">
		INSERT INTO users (email, name)
		VALUES (#{email}, #{name})
	</insert>

</mapper>
